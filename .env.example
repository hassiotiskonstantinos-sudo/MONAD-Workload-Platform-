# Database
DATABASE_URL="postgresql://monad:monad_secret@localhost:5432/monad_workload"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Manager emails (comma-separated)
ADMIN_EMAILS="manager@yourfirm.com"

# Google Calendar settings
# Prefix for calendar events created by the app
CALENDAR_EVENT_PREFIX="[MONAD]"

# Allowed email domain (leave empty to allow any Google account)
ALLOWED_DOMAIN="yourfirm.com"
